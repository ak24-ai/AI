Q2)B.Write a python program to develop fitness predictors using Random 
Forest Classification to predict whether a person is FIT or UNFIT based on: Age, Exercise Hours per Week Accept the input from user and predict for multiple 
people [20 marks]

Program


import pandas as pd
from sklearn.ensemble import RandomForestClassifier

data = {
    'Age': [18, 20, 22, 25, 28, 30, 35, 40, 45, 50],
    'Exercise_Hours': [6, 7, 5, 6, 4, 5, 3, 2, 2, 1],
    'Fitness': ['FIT', 'FIT', 'FIT', 'FIT', 'FIT',
    'FIT', 'UNFIT', 'UNFIT', 'UNFIT', 'UNFIT']
}
df = pd.DataFrame(data)
print("Training Data:")
print(df)

X = df[['Age', 'Exercise_Hours']]

Y = df['Fitness']

model = RandomForestClassifier(n_estimators=100, 
random_state=42)

model.fit(X, Y)
n = int(input("\nEnter number of people: "))

people = [] 

for i in range(n):
    print("\nPerson", i + 1)
    age = int(input("Enter Age: "))
    exercise = float(input("Enter Exercise Hours per Week: "))
    people.append([age, exercise])

input_df = pd.DataFrame(
 people,
 columns=['Age', 'Exercise_Hours']
)

predictions = model.predict(input_df)

print("\nFitness Prediction:")
print("------------------------------")
for i in range(n):
    print( "Person", i + 1,
   "Age:", input_df.iloc[i]['Age'],
   "Exercise Hours:", 
input_df.iloc[i]['Exercise_Hours'],
        "Fitness:", predictions[i]
 )


