Q1 [A] Subject Marks Charts [10 Marks]

import matplotlib.pyplot as plt

subjects = ['Maths', 'Python', 'DBMS', 'AI', 'IoT']
marks = [85, 92, 78, 65, 88]

fig, axes = plt.subplots(1, 2, figsize=(12, 5))


axes[0].pie(marks, labels=subjects,
            autopct='%1.1f%%', startangle=90)
axes[0].set_title('Subject Marks Pie Chart')


axes[1].bar(subjects, marks, color='skyblue')
axes[1].set_title('Subject Marks Bar Chart')
axes[1].set_ylabel('Marks')

plt.tight_layout()
plt.show()


